{
  "name": "sharefi-electron",
  "author": "Luca Fornerone",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run ui:dev\" \"npm run core:dev\"",
    "build": "npm run ui:build && npm run core:build",
    "ui:dev": "vite ./src/ui",
    "ui:build": "vue-tsc -b ./src/ui && vite build ./src/ui",
    "core:dev": "vite ./dist/dev",
    "core:build": "esbuild src/core/main.ts --bundle --platform=node --external:electron --outfile=dist/release/main.js && esbuild src/core/preload.ts --bundle --platform=node --external:electron --outfile=dist/release/preload.js",
    "start": "electron ./dist/release",
    "prepare": "husky",
    "build:snap": "electron-builder --linux snap --projectDir ./dist/release --publish never",
    "build:deb": "electron-builder --linux deb --projectDir ./dist/release --publish never",
    "build:rpm": "electron-builder --linux rpm --projectDir ./dist/release --publish never",
    "build:mac": "electron-builder --mac --projectDir ./dist/release --publish never",
    "build:mas": "rm -rf ./dist/release/dist && rm -f ./dist/release/package-lock.json && npm run build && electron-builder --mac mas --projectDir ./dist/release --publish never",
    "build:win": "electron-builder --win --projectDir ./dist/release --publish never",
    "website:dev": "vite ./website",
    "website:build": "vue-tsc -b ./website && vite build ./website"
  },
  "imports": {
    "#server/*": "./src/server/*",
    "#shared/*": "./src/shared/*",
    "#core/*": "./src/core/*"
  },
  "lint-staged": {
    "**/*": "biome check --write"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@hono/node-server": "^2.1.1",
    "@lucide/vue": "^1.35.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "esbuild": "^0.28.2",
    "hono": "^4.13.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "mime": "^4.1.0",
    "network-default-gateway": "^2.0.2",
    "network-local-devices": "^2.0.0",
    "radix-vue": "^1.9.7",
    "reka-ui": "^2.10.4",
    "selfsigned": "^5.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "undici": "^8.10.1",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-tsc": "^3.3.11"
  }
}
